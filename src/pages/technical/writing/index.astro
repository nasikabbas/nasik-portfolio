---
/**
 * Writing, technical register: the essays and the notes, newest first. Titles, summaries, dates and
 * statuses come from `src/lib/essays.ts` and `src/lib/notes.ts`, so these lists cannot disagree with
 * the pieces themselves.
 */
import { path } from '../../../config/site';
import Base from '../../../layouts/Base.astro';
import { ESSAYS, longDate } from '../../../lib/essays';
import { NOTES } from '../../../lib/notes';

const essays = [...ESSAYS].sort((a, b) => b.published.localeCompare(a.published));
const notes = [...NOTES].sort((a, b) => b.published.localeCompare(a.published));
---

<Base
  title="Writing — essays on putting AI agents to work"
  description="Essays on what holds up when AI agents do real work: how knowledge travels between people, and who gets to decide."
  path="/technical/writing/"
  register="technical"
  counterpart="/writing/"
>
  <section class="hero">
    <div class="wrap">
      <p class="eyebrow">Essays and notes</p>
      <h1>Writing</h1>
      <p class="lede">
        Essays from putting AI agents to work, written up when they hold, and shorter notes on what
        is being read and tested now. Each one says where its numbers come from and what it doesn't
        know yet.
      </p>
    </div>
  </section>

  <section class="section" aria-labelledby="essays-heading">
    <div class="wrap">
      <h2 id="essays-heading">All essays</h2>
      <div class="essay-list">
        {
          essays.map((e) => (
            <a class="feature" href={path(`/technical/writing/${e.slug}/`)}>
              <p class="eyebrow">Essay · {longDate(e.published)}</p>
              <h3>{e.title}</h3>
              <p>{e.dek}</p>
              <span class="feature__cta">Read the essay →</span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="notes-heading">
    <div class="wrap">
      <h2 id="notes-heading">Notes</h2>
      <p>
        A few hundred words each, dated, with where the thinking stands: reading, an idea, an
        experiment planned, or a result.
      </p>
      <div class="essay-list">
        {
          notes.map((n) => (
            <a class="feature" href={path(`/technical/notes/${n.slug}/`)}>
              <p class="eyebrow">
                Note · {longDate(n.published)} · {n.status}
              </p>
              <h3>{n.title}</h3>
              <p>{n.dek}</p>
              <span class="feature__cta">Read the note →</span>
            </a>
          ))
        }
      </div>
    </div>
  </section>
</Base>
