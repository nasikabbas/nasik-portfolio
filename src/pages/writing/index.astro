---
/**
 * Writing, plain register: what each essay is about, in plain words, with a link to the essay.
 *
 * The essays themselves live in the technical register — their subject is the vocabulary the plain
 * register rejects — so this page is their counterpart: each one named and summarised for a reader
 * who does not work in software (ADR 002).
 */
import { path } from '../../config/site';
import Base from '../../layouts/Base.astro';
import { ESSAYS, longDate } from '../../lib/essays';

const essays = [...ESSAYS].sort((a, b) => b.published.localeCompare(a.published));
---

<Base
  title="Writing"
  description="Short essays on what we learn from putting AI to work in real businesses, with a plain summary of each."
  path="/writing/"
  register="plain"
  counterpart="/technical/writing/"
>
  <section class="hero">
    <div class="wrap">
      <p class="eyebrow">Writing</p>
      <h1>What we're learning</h1>
      <p class="lede">
        Short essays on what holds up when AI does real work. They are written for engineers, so each one
        has a plain summary here.
      </p>
    </div>
  </section>

  <section class="section" aria-labelledby="essays-heading">
    <div class="wrap">
      <h2 id="essays-heading">The essays</h2>
      <div class="essay-list">
        {
          essays.map((e) => (
            <a class="feature" href={path(`/technical/writing/${e.slug}/`)}>
              <p class="eyebrow">{longDate(e.published)}</p>
              <h3>{e.plainTitle}</h3>
              <p>{e.plainSummary}</p>
              <span class="feature__cta">Read the essay →</span>
            </a>
          ))
        }
      </div>
    </div>
  </section>
</Base>
